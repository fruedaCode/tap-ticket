NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, account deletion>
# AI provider: groq (US) | mistral | scaleway | ovh (all EU) — see README
AI_PROVIDER=groq
MOCK_SCAN=false

# Groq (US-hosted — the pre-EU baseline)
GROQ_API_KEY=<groq key — server only>
GROQ_MODEL=qwen/qwen3.6-27b

# Mistral Document AI (EU) — used when AI_PROVIDER=mistral
MISTRAL_API_KEY=<mistral key — server only>
MISTRAL_MODEL=mistral-ocr-latest

# Scaleway Generative APIs (EU, Paris) — used when AI_PROVIDER=scaleway
SCALEWAY_API_KEY=<scaleway secret key — server only>
SCALEWAY_MODEL=mistral-small-3.2-24b-instruct-2506
SCALEWAY_BASE_URL=https://api.scaleway.ai/v1

# OVHcloud AI Endpoints (EU, France) — used when AI_PROVIDER=ovh
OVH_API_KEY=<ovh ai endpoints token — server only>
OVH_MODEL=Qwen2.5-VL-72B-Instruct
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1

# Server log level: debug | info | warn | error (default: debug in dev, info in prod)
LOG_LEVEL=debug

# Stripe billing (optional — leave empty to run with billing disabled)
STRIPE_SECRET_KEY=<secret key — server only>
STRIPE_WEBHOOK_SECRET=<whsec_... from `stripe listen` or the dashboard>
STRIPE_PRICE_STANDARD=<price_... for the €2.50/mo Standard plan>
STRIPE_PRICE_PRO=<price_... for the €10/mo Pro plan>
NEXT_PUBLIC_SITE_URL=<public origin, e.g. https://your-app.fly.dev — used for Stripe redirects>

# PostHog analytics (optional — leave empty to disable)
NEXT_PUBLIC_POSTHOG_KEY=<publishable key>
NEXT_PUBLIC_POSTHOG_HOST=<eu or us api url>
